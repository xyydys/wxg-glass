// FIX95 (tools/shader_sim): a texture with pixels (premultiplied RGBA
// floats), sampled bilinearly with clamp-to-edge like wxgSampler.
template<typename T, access::A M = access::sample> struct texture2d {
    const float *data = nullptr; int w = 1, h = 1;
    float4 texel(int x, int y) const {
        if (!data) return float4{0,0,0,0};
        x = x < 0 ? 0 : (x >= w ? w - 1 : x); y = y < 0 ? 0 : (y >= h ? h - 1 : y);
        const float *p = data + 4 * (y * w + x); return float4{p[0],p[1],p[2],p[3]};
    }
    float4 sample(sampler, float2 uv) const {
        if (!data) return float4{0,0,0,0};
        float fx = uv.x * w - .5f, fy = uv.y * h - .5f;
        int x0 = (int)std::floor(fx), y0 = (int)std::floor(fy); float tx = fx - x0, ty = fy - y0;
        float4 a = texel(x0, y0), b = texel(x0 + 1, y0), c = texel(x0, y0 + 1), d = texel(x0 + 1, y0 + 1);
        return (a * (1 - tx) + b * tx) * (1 - ty) + (c * (1 - tx) + d * tx) * ty;
    }
    void write(float4, uint2) const {}
    uint get_width() const { return (uint)w; }
    uint get_height() const { return (uint)h; }
};
